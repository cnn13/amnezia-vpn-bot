[Unit]
Description=AmneziaWG Telegram Admin Bot
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/awgbot/config.env
WorkingDirectory=/opt/awgbot
ExecStart=/opt/awgbot/venv/bin/python /opt/awgbot/bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
