# Copy to /etc/awgbot/config.env on server and fill values.
# chmod 600 /etc/awgbot/config.env   # keep secrets off world-readable

# Telegram bot token from @BotFather
BOT_TOKEN="123456789:AAEabcdef..."

# Comma-separated Telegram user IDs of admins (your own id)
# How to find: @userinfobot in Telegram → send any message → shows your ID
ADMIN_IDS="123456789"

# Public IP of this server (what clients will put as Endpoint)
SERVER_IP="1.2.3.4"

# AdGuard Home admin credentials — user picks these; install.sh bcrypts the pass into AdGuardHome.yaml
ADGUARD_USER="admin"
ADGUARD_PASS="change_me_strong_password"

# Optional: path inside amnezia-awg* container where awg0.conf lives (default is fine for Amnezia 3.1)
# AWG_DIR_IN_CT="/opt/amnezia/awg"

# Optional: DNS clients will use (default = awg0 alias → AdGuard)
# CLIENT_DNS="10.8.1.254"
